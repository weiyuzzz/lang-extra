# Generated build trees that were accidentally committed inside the vendored
# sources. These contain CMake-produced .vcxproj/.sln/zconf.h files as well as
# .obj/.pdb, so ignore the whole directories explicitly.
langTextExtra/Debug/
langTextExtra/langTextExtra/Debug/
